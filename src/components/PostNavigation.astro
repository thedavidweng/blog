---
import type { CollectionEntry } from 'astro:content';
import { getPostInfo } from '../lib/content';
import type { Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { locale, prev, next } = Astro.props;

const isZh = locale === 'zh';

const prevInfo = prev ? getPostInfo(prev) : null;
const nextInfo = next ? getPostInfo(next) : null;
---

<nav class="post-nav" aria-label={isZh ? '文章导航' : 'Post navigation'}>
  {prevInfo ? (
    <a href={prevInfo.url} class="card-link">
      <span class="post-nav-label">{isZh ? '上一篇' : 'Previous'}</span>
      <span class="card-link-title">{prevInfo.title}</span>
    </a>
  ) : <div />}
  {nextInfo ? (
    <a href={nextInfo.url} class="card-link post-nav-next">
      <span class="post-nav-label">{isZh ? '下一篇' : 'Next'}</span>
      <span class="card-link-title">{nextInfo.title}</span>
    </a>
  ) : <div />}
</nav>

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
