---
import { BookOpenText, BriefcaseBusiness, House, Info, Languages, Moon, Sun, Tags } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { siteConfig } from '../site.config';
import { t } from '../config/i18n';
import { alternateLocale, localeTag, locales, localizedPath, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  active: 'posts' | 'tags' | 'about';
  alternatePath: string;
}

const { locale, active, alternatePath } = Astro.props;

const localeContent = (l: Locale) => {
  const copy = t(l);
  const alt = alternateLocale(l);
  return {
    role: siteConfig.role[l],
    brandHref: localizedPath(l),
    nav: [
      { key: 'posts', href: localizedPath(l), label: siteConfig.nav[l].posts },
      { key: 'tags', href: localizedPath(l, '/tags/'), label: siteConfig.nav[l].tags },
      { key: 'about', href: localizedPath(l, '/about/'), label: siteConfig.nav[l].about },
    ],
    localeLink: { href: localizedPath(alt), hreflang: localeTag[alt], target: alt, label: copy.switchLocale },
    navLandmark: copy.navLandmark,
    socialLandmark: copy.socialLandmark,
    toolbarLandmark: copy.toolbarLandmark,
    themeToggle: copy.themeToggle,
  };
};

const i18n = Object.fromEntries(locales.map((l) => [l, localeContent(l)]));
const content = i18n[locale];

const navIcons = { posts: BookOpenText, tags: Tags, about: Info };
const social = siteConfig.social;
const socialIcons = {
  portfolio: BriefcaseBusiness,
  home: House
};
---

<aside class="site-sidebar" transition:persist="sidebar">
  <div class="sidebar-inner">
    <a class="brand" href={content.brandHref} aria-label={siteConfig.name}>
      <span class="brand-mark">
        <img
          src="/android-chrome-512x512.png"
          alt=""
          width="58"
          height="58"
          decoding="async"
          fetchpriority="low"
        />
      </span>
      <span class="brand-text">
        <span class="brand-name">{siteConfig.author}</span>
        <span class="brand-role">{content.role}</span>
      </span>
    </a>

    <div class="sidebar-actions">
      <nav class="site-nav" aria-label={content.navLandmark}>
        {
          content.nav.map(({ key, href, label }) => {
            const Icon = navIcons[key as keyof typeof navIcons];
            return (
              <a class="nav-link" href={href} data-nav-key={key} aria-current={active === key ? 'page' : undefined}>
                <Icon size={23} stroke-width={2.4} />
                <span>{label}</span>
              </a>
            );
          })
        }
      </nav>

      <nav class="social-nav" aria-label={content.socialLandmark}>
        {
          social.map((item, index) => (
            <>
              {index === 3 && <hr class="social-divider" aria-hidden="true" />}
              <a class="social-link" href={item.href} rel="me noopener noreferrer" target="_blank">
                {item.icon === 'github' || item.icon === 'linkedin' || item.icon === 'x' ? (
                  <BrandIcon brand={item.icon} size={23} />
                ) : (
                  (() => {
                    const Icon = socialIcons[item.icon];
                    return <Icon size={23} stroke-width={2.3} />;
                  })()
                )}
                <span>{item.label}</span>
              </a>
            </>
          ))
        }
      </nav>
    </div>
  </div>
</aside>

<div class="toolbar" role="group" transition:persist="toolbar" aria-label={content.toolbarLandmark}>
  <button class="icon-button" type="button" data-theme-toggle aria-label={content.themeToggle} title={content.themeToggle}>
    <Sun class="theme-light" size={22} />
    <Moon class="theme-dark" size={22} />
  </button>
  <a class="icon-button" href={alternatePath} hreflang={content.localeLink.hreflang} aria-label={content.localeLink.label} title={content.localeLink.label} data-locale-link data-locale-target={content.localeLink.target}>
    <Languages size={22} />
  </a>
</div>

<script is:inline define:vars={{ i18n }}>
  function updateActiveNav() {
    const current = location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.nav-link').forEach((link) => {
      const href = link instanceof HTMLAnchorElement ? new URL(link.href).pathname.replace(/\/+$/, '') || '/' : '';
      if (href === current) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function updateLocaleContent() {
    const content = i18n[document.documentElement.dataset.locale] ?? i18n.en;

    document.querySelectorAll('.nav-link').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const item = content.nav.find((n) => n.key === link.dataset.navKey);
      if (!item) return;
      link.href = item.href;
      const label = link.querySelector('span');
      if (label) label.textContent = item.label;
    });

    const roleEl = document.querySelector('.brand-role');
    if (roleEl) roleEl.textContent = content.role;
    const brandLink = document.querySelector('.brand');
    if (brandLink instanceof HTMLAnchorElement) brandLink.href = content.brandHref;

    const localeLink = document.querySelector('[data-locale-link]');
    if (localeLink instanceof HTMLAnchorElement) {
      localeLink.href = content.localeLink.href;
      localeLink.hreflang = content.localeLink.hreflang;
      localeLink.dataset.localeTarget = content.localeLink.target;
      localeLink.setAttribute('aria-label', content.localeLink.label);
      localeLink.title = content.localeLink.label;
    }

    const toolbar = document.querySelector('.toolbar');
    if (toolbar) toolbar.setAttribute('aria-label', content.toolbarLandmark);
    const themeBtn = document.querySelector('[data-theme-toggle]');
    if (themeBtn) {
      themeBtn.setAttribute('aria-label', content.themeToggle);
      themeBtn.title = content.themeToggle;
    }

    const siteNav = document.querySelector('.site-nav');
    if (siteNav) siteNav.setAttribute('aria-label', content.navLandmark);
    const socialNav = document.querySelector('.social-nav');
    if (socialNav) socialNav.setAttribute('aria-label', content.socialLandmark);
  }

  document.addEventListener('astro:after-swap', () => {
    updateActiveNav();
    updateLocaleContent();
  });

  const root = document.documentElement;
  const themeButton = document.querySelector('[data-theme-toggle]');
  themeButton?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    try {
      localStorage.setItem('theme', nextTheme);
    } catch {
      /* ignore */
    }
  });

  document.querySelector('[data-locale-link]')?.addEventListener('click', (event) => {
    const target = event.currentTarget instanceof HTMLAnchorElement ? event.currentTarget.dataset.localeTarget : null;
    if (!target) return;
    try {
      localStorage.setItem('preferred-locale', target);
    } catch {
      /* ignore */
    }
  });
</script>

<style>
  :root[data-theme="dark"] .theme-light,
  :root:not([data-theme="dark"]) .theme-dark {
    display: none;
  }
</style>
