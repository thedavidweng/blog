---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug } from '../lib/posts';
import { t } from '../config/i18n';
import { postUrl, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { locale, prev, next } = Astro.props;
const copy = t(locale);
---

<nav class="post-nav" aria-label={copy.postNav}>
  {prev ? (
    <a href={postUrl(locale, getPostSlug(prev))} class="card-link">
      <span class="post-nav-label">{copy.prevPost}</span>
      <span class="card-link-title">{prev.data.title}</span>
    </a>
  ) : <div />}
  {next ? (
    <a href={postUrl(locale, getPostSlug(next))} class="card-link post-nav-next">
      <span class="post-nav-label">{copy.nextPost}</span>
      <span class="card-link-title">{next.data.title}</span>
    </a>
  ) : <div />}
</nav>

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
