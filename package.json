{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && pnpm test",
    "check:images": "node scripts/check-image-formats.js",
    "test:dist": "tsx tests/dist-contract.test.ts",
    "convert-images": "tsx scripts/convert-to-avif.mjs",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt --write 'src/**/*.{ts,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,js}'",
    "format:check": "vp fmt --check 'src/**/*.{ts,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,js}'",
    "deploy": "PUBLIC_SITE_URL=https://blog.blahaj.uk pnpm build && pnpm --filter blog-worker exec cf deploy",
    "test": "tsx tests/source-contract.test.ts && tsx tests/content-contract.test.ts && tsx tests/posts.test.ts && tsx tests/plugins.test.ts && tsx tests/link-card.test.ts && tsx tests/markdown-response.test.ts && tsx tests/locale.test.ts && tsx tests/i18n.test.ts && tsx tests/robots.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text --src=src pnpm test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "0.42.0",
    "medium-zoom": "^1.1.2",
    "open-graph-scraper": "^6.12.0",
    "reading-time": "^1.5.0",
    "satteri": "0.10.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tocbot": "^4.36.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/turndown": "^5.0.6",
    "c8": "^12.0.0",
    "knip": "^6.43.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plus": "1.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.15.0"
}
