---
import { createLinkCard, faviconUrl } from '../plugins/link-card';

interface Props {
  url: string;
  title: string;
  description?: string;
  image?: string;
  favicon?: string;
  domain?: string;
}

const { url, title, description = '', image = '', favicon, domain } = Astro.props;
const displayUrl = domain || new URL(url).hostname;

const html = createLinkCard({
  title,
  description,
  faviconSrc: favicon || faviconUrl(displayUrl),
  ogImageSrc: image,
  ogImageAlt: title,
  displayUrl,
  url,
});
---

<Fragment set:html={html} />
