---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug } from '../lib/posts';
import { t } from '../config/i18n';
import { postUrl, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  posts: Array<CollectionEntry<'posts'>>;
}

const { locale, posts } = Astro.props;

if (posts.length === 0) return null;

const copy = t(locale);

const items = posts.map((post) => ({
  url: postUrl(locale, getPostSlug(post)),
  title: post.data.title,
  description: post.data.description,
}));
---

<section class="related-posts" aria-label={copy.relatedLabel}>
  <h2 class="related-posts-heading">{copy.relatedHeading}</h2>
  <ul class="related-posts-list">
    {items.map((item) => (
      <li>
        <a href={item.url} class="card-link">
          <span class="card-link-title">{item.title}</span>
          <span class="related-posts-desc">{item.description}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .related-posts {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .related-posts-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .related-posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-posts-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
