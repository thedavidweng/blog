---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug } from '../lib/posts';
import { publishedLabel, t, tagLabel } from '../config/i18n';
import { postUrl, type Locale } from '../lib/locale';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
}

const { post, locale } = Astro.props;
const slug = getPostSlug(post);
const dateLabel = publishedLabel(locale, post.data.publishedDate);
---

<article>
  <a class="post-card" href={postUrl(locale, slug)}>
    <time class="post-meta" datetime={post.data.publishedDate.toISOString()}>{dateLabel}</time>
    <h2 class="post-title">{post.data.title}</h2>
    <p class="post-description">{post.data.description}</p>
    <ul class="tag-list" aria-label={t(locale).articleTags}>
      {post.data.tags.map((tag) => <li><span class="tag-pill">{tagLabel(locale, tag)}</span></li>)}
    </ul>
  </a>
</article>
