---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../config/i18n';
import { absoluteUrl, siteConfig } from '../../site.config';
import { alternateLocale, localeTag, localizedPath, type Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const title = copy.aboutTitle;
const description = copy.aboutDescription(siteConfig.author);
const path = localizedPath(locale, '/about/');
const alternatePath = localizedPath(alternateLocale(locale), '/about/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: copy.aboutName(siteConfig.author),
  description,
  url: absoluteUrl(path),
  about: {
    '@type': 'Person',
    name: siteConfig.author,
    url: absoluteUrl('/')
  },
  inLanguage: localeTag[locale]
};
---

<BaseLayout locale={locale} title={title} description={description} path={path} alternatePath={alternatePath} active="about" jsonLd={jsonLd}>
  <section class="content-wrap">
    <header class="hero">
      <h1>{title}</h1>
      <p class="hero-copy">{siteConfig.role[locale]}</p>
    </header>
    <div class="about-panel">
      {siteConfig.about[locale].map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</BaseLayout>
