---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/content';
import { t, tagLabel } from '../../config/i18n';
import { alternateLocale, localizedPath, tagUrl, type Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const tags = await getTags(locale);
const path = localizedPath(locale, '/tags/');
const alternatePath = localizedPath(alternateLocale(locale), '/tags/');
---

<BaseLayout locale={locale} title={copy.tagsTitle} description={copy.tagsDescription} path={path} alternatePath={alternatePath} active="tags">
  <section class="content-wrap">
    <header class="hero">
      <h1>{copy.tagsTitle}</h1>
      <p class="hero-copy">{copy.tagsHero}</p>
    </header>
    <div class="tag-grid">
      {tags.map((tag) => <a class="tag-pill" href={tagUrl(locale, tag)}>{tagLabel(locale, tag)}</a>)}
    </div>
  </section>
</BaseLayout>
