---
import PostCard from '../PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { t, tagLabel } from '../../config/i18n';
import { alternateLocale, tagUrl, type Locale } from '../../lib/locale';

interface Props {
  locale: Locale;
  tag: string;
}

const { locale, tag } = Astro.props;
const copy = t(locale);
const posts = (await getPublishedPosts(locale)).filter((post) => post.data.tags.includes(tag));
const label = tagLabel(locale, tag);
const description = copy.taggedDescription(label);
const alternatePath = tagUrl(alternateLocale(locale), tag);
---

<BaseLayout locale={locale} title={`#${label}`} description={description} path={tagUrl(locale, tag)} alternatePath={alternatePath} active="tags">
  <section class="content-wrap">
    <header class="hero">
      <p class="eyebrow">{copy.tagEyebrow}</p>
      <h1>#{label}</h1>
      <p class="hero-copy">{description}</p>
    </header>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
