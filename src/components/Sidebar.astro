---
import { BookOpenText, BriefcaseBusiness, House, Info, Languages, Moon, Sun, Tags } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { siteConfig } from '../site.config';
import { t } from '../config/i18n';
import { alternateLocale, localeTag, localizedPath, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  active: 'posts' | 'tags' | 'about';
  alternatePath: string;
}

const { locale, active, alternatePath } = Astro.props;

const copy = t(locale);
const alt = alternateLocale(locale);
const nav = [
  { key: 'posts', href: localizedPath(locale), label: siteConfig.nav[locale].posts },
  { key: 'tags', href: localizedPath(locale, '/tags/'), label: siteConfig.nav[locale].tags },
  { key: 'about', href: localizedPath(locale, '/about/'), label: siteConfig.nav[locale].about },
] as const;

const navIcons = { posts: BookOpenText, tags: Tags, about: Info };
const social = siteConfig.social;
const socialIcons = {
  portfolio: BriefcaseBusiness,
  home: House
};
---

<aside class="site-sidebar">
  <div class="sidebar-inner">
    <a class="brand" href={localizedPath(locale)} aria-label={siteConfig.name}>
      <span class="brand-mark">
        <img
          src="/android-chrome-512x512.png"
          alt=""
          width="58"
          height="58"
          decoding="async"
          fetchpriority="low"
        />
      </span>
      <span class="brand-text">
        <span class="brand-name">{siteConfig.author}</span>
        <span class="brand-role">{siteConfig.role[locale]}</span>
      </span>
    </a>

    <div class="sidebar-actions">
      <nav class="site-nav" aria-label={copy.navLandmark}>
        {
          nav.map(({ key, href, label }) => {
            const Icon = navIcons[key];
            return (
              <a class="nav-link" href={href} aria-current={active === key ? 'page' : undefined}>
                <Icon size={23} stroke-width={2.4} />
                <span>{label}</span>
              </a>
            );
          })
        }
      </nav>

      <nav class="social-nav" aria-label={copy.socialLandmark}>
        {
          social.map((item, index) => (
            <>
              {index === 3 && <hr class="social-divider" aria-hidden="true" />}
              <a class="social-link" href={item.href} rel="me noopener noreferrer" target="_blank">
                {item.icon === 'github' || item.icon === 'linkedin' || item.icon === 'x' ? (
                  <BrandIcon brand={item.icon} size={23} />
                ) : (
                  (() => {
                    const Icon = socialIcons[item.icon];
                    return <Icon size={23} stroke-width={2.3} />;
                  })()
                )}
                <span>{item.label}</span>
              </a>
            </>
          ))
        }
      </nav>
    </div>
  </div>
</aside>

<div class="toolbar" role="group" aria-label={copy.toolbarLandmark}>
  <button class="icon-button" type="button" data-theme-toggle aria-label={copy.themeToggle} title={copy.themeToggle}>
    <Sun class="theme-light" size={22} />
    <Moon class="theme-dark" size={22} />
  </button>
  <a class="icon-button" href={alternatePath} hreflang={localeTag[alt]} aria-label={copy.switchLocale} title={copy.switchLocale} data-locale-link data-locale-target={alt}>
    <Languages size={22} />
  </a>
</div>

<script is:inline>
  const root = document.documentElement;
  const themeButton = document.querySelector('[data-theme-toggle]');
  themeButton?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    try {
      localStorage.setItem('theme', nextTheme);
    } catch {
      /* ignore */
    }
  });

  document.querySelector('[data-locale-link]')?.addEventListener('click', (event) => {
    const target = event.currentTarget instanceof HTMLAnchorElement ? event.currentTarget.dataset.localeTarget : null;
    if (!target) return;
    try {
      localStorage.setItem('preferred-locale', target);
    } catch {
      /* ignore */
    }
  });
</script>

<style>
  :root[data-theme="dark"] .theme-light,
  :root:not([data-theme="dark"]) .theme-dark {
    display: none;
  }
</style>
