---
import { ChevronUp } from '@lucide/astro';
import { t } from '../config/i18n';
import type { Locale } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale).backToTop;
---

<button type="button" class="back-to-top icon-button" data-back-to-top aria-label={label}>
  <ChevronUp size={22} stroke-width={2.25} aria-hidden="true" />
</button>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-back-to-top]');
    const update = () => btn.classList.toggle('back-to-top--visible', window.scrollY > 360);

    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });

    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
