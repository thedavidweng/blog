{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun --bun astro build",
    "preview": "astro preview",
    "check": "bun --bun astro check && bun run test",
    "check:images": "bun scripts/check-image-formats.js",
    "test:dist": "bun tests/dist-contract.test.ts",
    "convert-images": "bun scripts/convert-to-avif.mjs",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt --write 'src/**/*.{ts,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,js}'",
    "format:check": "vp fmt --check 'src/**/*.{ts,json}' 'tests/**/*.ts' 'scripts/**/*.{ts,mjs,js}'",
    "deploy": "PUBLIC_SITE_URL=https://blog.blahaj.uk bun run build && bun run --cwd deploy cf deploy",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/astro": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "0.42.0",
    "medium-zoom": "^1.1.2",
    "open-graph-scraper": "^6.12.0",
    "reading-time": "^1.5.0",
    "satteri": "0.10.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tocbot": "^4.36.8",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.3",
    "@types/turndown": "^5.0.6",
    "knip": "^6.43.0",
    "typescript": "^6.0.3",
    "vite-plus": "1.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "workspaces": ["deploy"],
  "trustedDependencies": ["esbuild", "sharp", "workerd"],
  "overrides": {
    "fast-uri@3": ">=3.1.9 <4",
    "zod": ">=4.6.7",
    "undici@7": ">=7.30.1 <8",
    "postcss-selector-parser": ">=7.1.6",
    "yaml-language-server>yaml": "2.9.1",
    "yaml": "2.9.1",
    "@ungap/structured-clone": "1.3.1",
    "esbuild": ">=0.28.1",
    "ws": ">=8.21.0"
  }
}
