---
import LocaleRedirect from '../LocaleRedirect.astro';
import PostCard from '../PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { t } from '../../config/i18n';
import { absoluteUrl, siteConfig } from '../../site.config';
import {
  alternateLocale,
  defaultLocale,
  localeTag,
  localizedPath,
  type Locale,
} from '../../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDefault = locale === defaultLocale;
const posts = await getPublishedPosts(locale);
const title = t(locale).homeTitle;
const path = localizedPath(locale);
const alternatePath = localizedPath(alternateLocale(locale));

const siteUrl = absoluteUrl('/');
const socialUrls = siteConfig.social.flatMap((s) =>
  ['GitHub', 'LinkedIn', 'X'].includes(s.label) ? [s.href] : [],
);
const author = {
  '@type': 'Person',
  name: siteConfig.author,
  jobTitle: 'Developer and Designer',
  knowsAbout: [
    'Open-source tools',
    'Desktop application development',
    'AI-integrated creative work',
  ],
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      name: siteConfig.name,
      description: siteConfig.description[locale],
      url: absoluteUrl(path),
      author,
      inLanguage: localeTag[locale],
    },
    {
      '@type': 'Organization',
      name: siteConfig.name,
      url: siteUrl,
      logo: absoluteUrl('/android-chrome-512x512.png'),
      sameAs: socialUrls,
    },
    { ...author, url: siteUrl, sameAs: socialUrls },
    {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: siteUrl,
    },
  ],
};
---

<BaseLayout
  locale={locale}
  title={title}
  description={siteConfig.description[locale]}
  path={path}
  alternatePath={alternatePath}
  active="posts"
  jsonLd={jsonLd}
  includeLocaleRedirect={isDefault}
>
  {isDefault && <LocaleRedirect slot="locale-redirect" />}
  <section class="content-wrap">
    <header class="hero">
      <h1>{title}</h1>
      <p class="hero-copy">{siteConfig.description[locale]}</p>
    </header>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
